<mvc:View
  controllerName="com.locationtracker.locationtracker.controller.Trips"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page
    id="tripsPage"
    title="Fleet Trips"
    showNavButton="true"
    navButtonPress=".onNavBack">

    <content>
      <VBox class="tripsPage" renderType="Bare">
        <HBox class="tripsStatsRow" wrap="Wrap">
          <VBox class="tripStatCard">
            <core:Icon src="sap-icon://journey-arrive" class="tripStatIcon" />
            <ObjectNumber number="{trips>/summary/totalTrips}" />
            <Text text="total trips" class="tripStatLabel" />
          </VBox>

          <VBox class="tripStatCard tripStatCardAccent">
            <core:Icon src="sap-icon://locate-me" class="tripStatIcon tripStatIconLive" />
            <ObjectNumber number="{trips>/summary/activeTrips}" state="Success" />
            <Text text="live now" class="tripStatLabel" />
          </VBox>

          <VBox class="tripStatCard">
            <core:Icon src="sap-icon://accept" class="tripStatIcon" />
            <ObjectNumber number="{trips>/summary/completedTrips}" />
            <Text text="completed" class="tripStatLabel" />
          </VBox>

          <VBox class="tripStatCard">
            <core:Icon src="sap-icon://map-2" class="tripStatIcon" />
            <ObjectNumber number="{trips>/summary/totalPoints}" />
            <Text text="points" class="tripStatLabel" />
          </VBox>
        </HBox>

        <Toolbar class="tripsToolbar">
          <SearchField
            width="22rem"
            placeholder="Search trips, drivers..."
            liveChange=".onSearchTrips" />

          <SegmentedButton selectedKey="{trips>/statusFilter}" selectionChange=".onFilterStatus">
            <items>
              <SegmentedButtonItem key="ALL" text="All" />
              <SegmentedButtonItem key="ACTIVE" text="Active" />
              <SegmentedButtonItem key="COMPLETED" text="Done" />
              <SegmentedButtonItem key="PAUSED" text="Paused" />
            </items>
          </SegmentedButton>

          <ToolbarSpacer />

          <Button text="Refresh" icon="sap-icon://refresh" type="Emphasized" press=".onRefreshTrips" />
          <Button text="Jump active" icon="sap-icon://locate-me" press=".onFocusActiveTrip" />
        </Toolbar>

        <f:FlexibleColumnLayout
  id="tripsFcl"
  class="tripsFcl"
  layout="{trips>/fcl/layout}"
  backgroundDesign="Solid">

  <f:beginColumnPages>
    <Page title="Trips" showHeader="false" enableScrolling="true">
      <content>
        <VBox class="tripsColumn">
          <List
            id="tripList"
            class="tripList"
            mode="SingleSelectMaster"
            growing="true"
            growingThreshold="20"
            busy="{trips>/loading}"
            items="{trips>/filteredTrips}"
            selectionChange=".onTripSelectionChange"
            noDataText="No trips match the current filters.">

            <CustomListItem type="Active">
              <HBox class="tripListItem" justifyContent="SpaceBetween" alignItems="Center">
                <core:HTML content="{= '&lt;div style=&quot;width:12px;height:12px;border-radius:3px;margin-right:0.75rem;background:' + ${trips>color} + '&quot;&gt;&lt;/div&gt;' }" />
                <VBox class="tripListCopy">
                  <HBox alignItems="Center" class="tripListTitleRow">
                    <Title text="{trips>shortTitle}" level="H5" />
                    <ObjectStatus
                      text="{trips>statusText}"
                      state="{trips>statusState}"
                      class="tripStatusBadge" />
                  </HBox>

                  <Text text="{trips>driverCompactLine}" class="tripMetaText" />
                </VBox>

                <VBox class="tripListMetrics" alignItems="End">
                  <ObjectNumber number="{trips>pointCount}" unit="pts" />
                  <Text text="{trips>durationText}" class="tripMetaText" />
                </VBox>
              </HBox>
            </CustomListItem>
          </List>
        </VBox>
      </content>
    </Page>
  </f:beginColumnPages>

  <f:midColumnPages>
    <Page title="Trip Details" showHeader="false" enableScrolling="true">
      <content>
        <VBox class="tripsColumn">
          <VBox
            class="tripDetailEmpty"
            visible="{= !${trips>/selectedTrip/ID} }">
            <IllustratedMessage
              illustrationType="sapIllus-SimpleCheckMark"
              title="Select a trip"
              description="Choose a trip to inspect timing, driver, coordinates, and recent captured points." />
          </VBox>

          <VBox
            class="tripDetailContent"
            visible="{= !!${trips>/selectedTrip/ID} }">

            <HBox justifyContent="SpaceBetween" wrap="Wrap" class="tripDetailHeader">
              <VBox>
                <HBox alignItems="Center">
                  <core:HTML content="{= '&lt;div style=&quot;width:14px;height:14px;border-radius:3px;margin-right:0.5rem;background:' + ${trips>/selectedTrip/color} + '&quot;&gt;&lt;/div&gt;' }" />
                  <Title text="{trips>/selectedTrip/title}" level="H3" />
                </HBox>
                <Text text="{trips>/selectedTrip/detailSubtitle}" class="tripMetaText" />
              </VBox>

              <ObjectStatus
                text="{trips>/selectedTrip/statusText}"
                state="{trips>/selectedTrip/statusState}"
                class="tripStatusBadge" />
            </HBox>

            <HBox class="tripInsightGrid" wrap="Wrap">
              <VBox class="tripInsightPill">
                <Text text="Started" class="tripStatLabel" />
                <Text text="{trips>/selectedTrip/startedTime}" />
              </VBox>

              <VBox class="tripInsightPill">
                <Text text="Ended" class="tripStatLabel" />
                <Text text="{trips>/selectedTrip/endedTime}" />
              </VBox>

              <VBox class="tripInsightPill">
                <Text text="Duration" class="tripStatLabel" />
                <Text text="{trips>/selectedTrip/durationShort}" />
              </VBox>

              <VBox class="tripInsightPill">
                <Text text="Points" class="tripStatLabel" />
                <Text text="{trips>/selectedTrip/pointCount}" />
              </VBox>
            </HBox>

            <VBox class="tripDetailFacts">
              <HBox class="tripFactRow">
                <Text text="Latest coordinates" class="tripFactLabel" />
                <Text text="{trips>/selectedTrip/coordinateValue}" class="sapUiSmallMonospace tripFactValue" />
              </HBox>

              <HBox class="tripFactRow">
                <Text text="Driver" class="tripFactLabel" />
                <Text text="{trips>/selectedTrip/driverCompactLine}" class="tripFactValue" />
              </HBox>

              <HBox class="tripFactRow">
                <Text text="Recording source" class="tripFactLabel" />
                <ObjectStatus text="{trips>/selectedTrip/sourceShort}" class="sourceBadge" />
              </HBox>

              <HBox class="tripFactRow">
                <Text text="Timeline" class="tripFactLabel" />
                <Text text="{trips>/selectedTrip/timelineCompact}" class="tripFactValue" />
              </HBox>
            </VBox>

            <VBox class="tripPointPreview">
              <Title text="Recent Captured Points" level="H5" />

              <List
                items="{trips>/selectedTrip/recentPoints}"
                noDataText="No location points captured for this trip yet.">
                <CustomListItem>
                  <HBox class="pointRow" justifyContent="SpaceBetween" alignItems="Center">
                    <VBox class="pointRowMain">
                      <Text text="{trips>coordinateLine}" class="sapUiSmallMonospace pointCoordinates" />
                      <Text text="{trips>compactDetailLine}" class="tripMetaText" />
                    </VBox>

                    <VBox alignItems="End">
                      <ObjectNumber number="{trips>speedDisplay}" unit="km/h" />
                      <ObjectStatus text="{trips>sourceShort}" class="sourceBadge" />
                    </VBox>
                  </HBox>
                </CustomListItem>
              </List>
            </VBox>
          </VBox>
        </VBox>
      </content>
    </Page>
  </f:midColumnPages>
</f:FlexibleColumnLayout>
      </VBox>
    </content>
  </Page>
</mvc:View>