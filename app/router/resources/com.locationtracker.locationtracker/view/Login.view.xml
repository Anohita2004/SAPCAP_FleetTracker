<mvc:View
  controllerName="com.locationtracker.locationtracker.controller.Login"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">
  <Page title="Login" class="loginPage">
    <content>
      <VBox class="loginShell" alignItems="Center" justifyContent="Center">
        <Title text="Fleet Tracker" level="H1" class="brandTitle" />
        <Text text="Choose how you want to sign in" class="brandSubtitle" />

        <HBox id="choiceBox" gap="1rem" visible="{= !${view>/login/mode} }" justifyContent="Center">
          <Button text="Login as Driver" type="Emphasized" press="onSelectDriver" />
          <Button text="Login as Admin" press="onSelectAdmin" />
        </HBox>

        <VBox id="driverLogin" visible="{= ${view>/login/mode} === 'driver' }" class="driverForm" alignItems="Center">
          <Text text="Driver login" />
          <Input id="emailInput" placeholder="Email" type="Email" value="{view>/login/email}" />
          <Input id="passwordInput" placeholder="Password" type="Password" value="{view>/login/password}" />
          <Button text="Login" type="Emphasized" press="onLogin" />
          <HBox class="auxActions" justifyContent="Center">
            <Button text="Back" type="Transparent" press="onBackToChoice" />
          </HBox>
        </VBox>

        <VBox id="adminLogin" visible="{= ${view>/login/mode} === 'admin' }" alignItems="Center">
          <Text text="Admin login uses BTP (xsuaa)" />
          <Button text="Login as Admin (BTP)" type="Emphasized" press="onAdminLogin" />
          <Button text="Back" type="Transparent" press="onBackToChoice" />
        </VBox>

      </VBox>
    </content>
  </Page>
</mvc:View>
