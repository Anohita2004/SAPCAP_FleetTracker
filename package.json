{
  "name": "location-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "CAP full stack location tracker with SAPUI5 frontend and SAP HANA persistence",
  "scripts": {
    "start": "node server.js",
    "predev": "cds deploy --to sqlite:db.sqlite",
    "dev": "cds watch",
    "hybrid": "cds watch --profile hybrid",
    "build": "cds build",
    "deploy": "cds deploy --to hana",
    "build:mta": "mbt build",
    "deploy:btp": "cf deploy mta_archives/location-tracker_1.0.0.mtar"
  },
  "dependencies": {
    "@cap-js/hana": "^1.9.2",
    "@sap/cds": "^8",
    "@sap/xssec": "^4",
    "bcryptjs": "^3.0.3",
    "express": "^4",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^2.0.5",
    "ws": "^8.13.0",
    "pdfkit": "^0.13.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8.9.19",
    "cds-plugin-ui5": "^0.13.0"
  },
  "cds": {
    "folders": {
      "db": "db",
      "srv": "srv",
      "app": "app"
    },
    "requires": {
      "db": {
        "kind": "sqlite",
        "[production]": {
          "kind": "hana",
          "impl": "@cap-js/hana",
          "deploy-format": "hdbtable"
        },
        "[hybrid]": {
          "kind": "hana",
          "impl": "@cap-js/hana",
          "deploy-format": "hdbtable"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "roles": [
                "FleetAdmin"
              ],
              "attr": {
                "given_name": "Fleet",
                "family_name": "Admin"
              }
            },
            "driver": {
              "roles": [
                "Driver"
              ],
              "attr": {
                "given_name": "Fleet",
                "family_name": "Driver"
              }
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
